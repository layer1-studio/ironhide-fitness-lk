diff --git a/functions/src/db/migrate.ts b/functions/src/db/migrate.ts
new file mode 100644
index 0000000..6d77d79
--- /dev/null
+++ b/functions/src/db/migrate.ts
@@ -0,0 +1,30 @@
+// Usage (from functions/):  npm run build && DATABASE_URL=... npm run migrate
+import * as fs from 'fs';
+import * as path from 'path';
+import { getPool } from './pool';
+
+async function main() {
+  const dir = path.resolve(__dirname, '../../db/migrations');
+  const pool = getPool();
+  await pool.query(`CREATE TABLE IF NOT EXISTS schema_migrations (name text PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now())`);
+  const done = new Set((await pool.query('SELECT name FROM schema_migrations')).rows.map((r) => r.name));
+  for (const file of fs.readdirSync(dir).filter((f) => f.endsWith('.sql')).sort()) {
+    if (done.has(file)) continue;
+    console.log('Applying', file);
+    const client = await pool.connect();
+    try {
+      await client.query('BEGIN');
+      await client.query(fs.readFileSync(path.join(dir, file), 'utf8'));
+      await client.query('INSERT INTO schema_migrations(name) VALUES ($1) ON CONFLICT DO NOTHING', [file]);
+      await client.query('COMMIT');
+    } catch (e) {
+      await client.query('ROLLBACK');
+      throw e;
+    } finally {
+      client.release();
+    }
+  }
+  await pool.end();
+  console.log('Migrations complete');
+}
+main().catch((e) => { console.error(e); process.exit(1); });
diff --git a/functions/src/db/pool.ts b/functions/src/db/pool.ts
new file mode 100644
index 0000000..725cdbc
--- /dev/null
+++ b/functions/src/db/pool.ts
@@ -0,0 +1,21 @@
+import { Pool } from 'pg';
+
+// DATABASE_URL is a Firebase secret:  firebase functions:secrets:set DATABASE_URL
+// e.g. postgresql://user:pass@host:5432/ironhide_scans?sslmode=require
+let pool: Pool | null = null;
+
+export function getPool(): Pool {
+  if (!pool) {
+    const connectionString = process.env.DATABASE_URL;
+    if (!connectionString) throw new Error('DATABASE_URL is not set');
+    pool = new Pool({
+      connectionString,
+      max: 3,                         // each function instance is small; keep total connections low
+      idleTimeoutMillis: 30_000,
+      connectionTimeoutMillis: 10_000,
+      ssl: /sslmode=disable/.test(connectionString) ? false : { rejectUnauthorized: false },
+    });
+    pool.on('error', (e) => console.error('[pg] idle client error', e));
+  }
+  return pool;
+}
