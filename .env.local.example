# Copy to .env.local and fill with your Firebase project's config to use real Firebase services
# Set VITE_USE_EMULATORS to 'false' to force real Firebase even on localhost.
VITE_USE_EMULATORS=false
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# ── HNB IPG (CyberSource) ───────────────────────────────────────────────────
# Obtain these from your CyberSource merchant dashboard once your HNB account is activated.
# Sandbox endpoint: https://testsecureacceptance.cybersource.com/pay
# Production endpoint: https://secureacceptance.cybersource.com/pay
HNB_CYBERSOURCE_ACCESS_KEY=your_cybersource_access_key
HNB_CYBERSOURCE_PROFILE_ID=your_cybersource_profile_id
HNB_CYBERSOURCE_SECRET_KEY=your_cybersource_secret_key
HNB_CYBERSOURCE_ENDPOINT=https://testsecureacceptance.cybersource.com/pay
# ── Google reCAPTCHA v2 ──────────────────────────────────────────────────────
# Server-side secret key — obtain from https://www.google.com/recaptcha/admin
RECAPTCHA_SECRET_KEY=your_recaptcha_v2_secret_key
# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
# ── App ──────────────────────────────────────────────────────────────────────
APP_URL=https://ironhide-fitness.web.app
# ── Email ────────────────────────────────────────────────────────────────────
GMAIL_USER=your_gmail_address@gmail.com
GMAIL_PASS=your_gmail_app_password
