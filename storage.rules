rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /deposits/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.size < 10 * 1024 * 1024;
    }

    // Member profile photos — owner can read/write their own, and admins can upload on behalf of a member.
    match /members/{uid}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (
        request.auth.uid == uid || isAdmin()
      ) && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}


