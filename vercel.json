{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/biometric-api/:path*",
      "destination": "https://primer-nanometer-ligament.ngrok-free.dev/api/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}