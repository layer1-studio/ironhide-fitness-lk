{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/biometric-api/enroll",
      "destination": "/api/enroll"
    },
    {
      "source": "/biometric-api/verify",
      "destination": "/api/verify"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
